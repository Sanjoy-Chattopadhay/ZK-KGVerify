# Data (auto-downloaded)
data/

# Trained weights: large, and regenerated by `run_all.py --stages train`.
# The commitment binds a digest of these, so what matters for verification is
# recorded in results/, not the tensors themselves.
checkpoints/

# Never commit a key. run_all.py reads it from --private-key or the
# environment and never writes it anywhere, but this is a second line.
.env
*.key
secrets.json

